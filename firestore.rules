rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{userId}/{document=**} {
      allow read, write: if request.auth != null
                         && request.auth.uid == 'ggV3xPVQgrYlMeQExI9UIlfFEbV2'
                         && userId == request.auth.uid;
    }
  }
}
